{
  "id": "com.notchly.example.pomodoro",
  "name": "Pomodoro",
  "version": "1.0.0",
  "author": "Notchly",
  "description": "A focus timer that survives restarts and tells you when it is done.",
  "entry": "index.html",
  "icon": "timer",
  "height": 132,
  "permissions": ["notifications"],
  "settings": [
    { "key": "focusMinutes", "type": "number", "label": "Focus length", "default": 25, "minimum": 5, "maximum": 60 },
    { "key": "breakMinutes", "type": "number", "label": "Break length", "default": 5, "minimum": 1, "maximum": 30 }
  ]
}
