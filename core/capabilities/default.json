{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the panel window needs. Tauri v2 denies calls that aren't listed here, so a missing entry shows up as a silently blank panel.",
  "windows": [
    "panel",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "global-shortcut:default",
    "autostart:default",
    "opener:default",
    "updater:default",
    "process:default"
  ]
}
